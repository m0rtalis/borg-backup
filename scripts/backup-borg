#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

# shellcheck disable=SC1091
source /container.env

backup() {
    echo "Backup borg repo"
    if ! borg info "${BORG_REPO}" &>/dev/null; then
        echo "Create new repository"

        borg init \
            --encryption repokey \
            --make-parent-dirs \
            "${BORG_REPO}"
    fi

    # Whitespace separated, so patterns cannot contain spaces
    local -a patterns present excludes=()
    local item
    read -ra patterns <<<"${EXCLUDE}"
    read -ra present <<<"${EXCLUDE_IF_PRESENT}"
    for item in "${patterns[@]}"; do
        excludes+=(--exclude "${item}")
    done
    for item in "${present[@]}"; do
        excludes+=(--exclude-if-present "${item}")
    done

    # Exit code 1 means warnings, e.g. a file changed while it was read. The archive
    # exists then, so the upload must go on. Anything above 1 is an error.
    local rc=0
    borg create \
        --verbose \
        --stats \
        --exclude-caches \
        "${excludes[@]}" \
        --compression "zlib" \
        --noxattrs \
        --numeric-ids \
        "${BORG_REPO}::${ARCHIVE}" \
        "${DATA}" "${OTHER_DATA}" || rc=$?
    if ((rc > 1)); then
        return "${rc}"
    fi
    if ((rc == 1)); then
        echo "Warning: borg create finished with warnings"
    fi
}

restore() {
    echo "Restore borg repo"
    if ! borg check --glob-archives "${ARCHIVE_PREFIX}*" --last 1 "${BORG_REPO}"; then
        echo "Repository or archive is corrupted. Fix before continuing."
        exit 1
    fi

    last_archive="$(borg list --glob-archives "${ARCHIVE_PREFIX}*" --last 1 --short)"
    restore_archive="${RESTORE_ARCHIVE:-${last_archive}}"

    (
        cd / &&
            borg extract \
                --noxattrs \
                --numeric-ids \
                --progress \
                "${BORG_REPO}::${restore_archive}"
    )

    if [[ -z "${RESTORE_UID}${RESTORE_GID}" ]]; then
        return
    fi
    # Only the paths of the archive, so files that were not restored keep their owner
    (
        cd / &&
            borg list --format "{path}{NUL}" "${BORG_REPO}::${restore_archive}" |
            xargs --null --no-run-if-empty chown --no-dereference "${RESTORE_UID}${RESTORE_GID:+:${RESTORE_GID}}" --
    )
}

prune() {
    echo "Prune borg repo"
    borg prune \
        --stats \
        --list \
        --glob-archives "${ARCHIVE_PREFIX}*" \
        --keep-within 5H \
        --keep-last 3 \
        --keep-daily 5 \
        --keep-weekly 4 \
        --keep-monthly 3 \
        --keep-yearly 2 \
        "${BORG_REPO}"
    borg compact "${BORG_REPO}"
}

check() {
    echo "Check borg archive"
    if ! borg check "${BORG_REPO}"; then
        echo "ERROR: Borg repository corrupted"
        return 1
    fi
}

if [[ $# == 0 || ($# == 1 && $1 == "backup") ]]; then
    backup
elif [[ $# == 1 && $1 == "restore" ]]; then
    restore
elif [[ $# == 1 && $1 == "prune" ]]; then
    prune
elif [[ $# == 1 && $1 == "check" ]]; then
    check
else
    echo "Operation $* not supported"
fi
