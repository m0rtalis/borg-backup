#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

# shellcheck disable=SC1091
source /container.env

restore() {
    status_code=$(
        curl \
            --head \
            --location \
            --silent \
            --output /dev/null \
            --write-out '%{http_code}' \
            "${NEXTCLOUD_HOST}"
    ) || true # curl exits non-zero and prints 000 when the host is down; errexit would abort before the prompt

    if [[ $status_code != 404 && $status_code != 503 ]]; then
        echo "Put nextcloud in maintenance mode!"
        echo "Use 'docker compose exec -u www-data nextcloud bash -c './occ maintenance:mode --on''"
        echo "Entered maintenance mode?"
        select dec in "Yes" "No"; do
            case $dec in
            Yes) break ;;
            No) exit 1 ;;
            esac
        done
    fi
}

if [[ $# == 1 && $1 == "restore" ]]; then
    restore
fi
