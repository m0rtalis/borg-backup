#!/usr/bin/env bash
# Verifies backup, prune, check and restore of an image for four setups: files only, MariaDB,
# MariaDB with a prepare hook, MariaDB on a custom port, plus EXCLUDE and EXCLUDE_IF_PRESENT,
# upload after borg warnings, the guard against a replaced repo, numeric owners and RESTORE_UID/GID,
# and SQLite databases (consistent copy under writes, restore, rejected paths). Usage: verify IMAGE
# Deviation from production: rclone uses a local-backend remote instead of AWS S3.
set -uo pipefail

IMAGE="${1:?usage: verify IMAGE}"
HERE="$(cd "$(dirname "$0")" && pwd)"
CONFIG="${HERE}/config"
NET=vb-net
DOMAIN=example.org
DB_IMAGE="mariadb:$(sed -n 's/^ARG MARIADB_VERSION="\(.*\)"/\1/p' "${HERE}/../Dockerfile")"

W="$(mktemp -d)"

remove_docker() {
	docker ps -aq --filter label=vb-verify | xargs -r docker rm -f >/dev/null 2>&1
	docker network rm "${NET}" >/dev/null 2>&1
	docker volume ls -q --filter label=vb-verify | xargs -r docker volume rm >/dev/null 2>&1
}

cleanup() {
	# Containers write as root, so the host user cannot remove the files
	docker run --rm -v "${W}:/w" --entrypoint sh "${IMAGE}" -c 'rm -rf /w/* /w/.[!.]*' >/dev/null 2>&1
	rmdir "${W}" 2>/dev/null
	remove_docker
}

# A killed earlier run leaves its containers behind, which would clash on the names
remove_docker
trap cleanup EXIT
mkdir -p "${W}"/{sec,remote}

fail=0
check() {
	local name="$1"
	shift
	if "$@" >"${W}/last.out" 2>&1; then
		echo "  PASS ${name}"
		return
	fi
	echo "  FAIL ${name}"
	sed 's/^/       | /' "${W}/last.out" | tail -15
	fail=1
}

wait_for() {
	local tries="$1"
	shift
	for _ in $(seq "${tries}"); do
		if "$@" >/dev/null 2>&1; then
			return 0
		fi
		sleep 1
	done
	return 1
}

for s in borg-repokey s3-keyid s3-passwd dbpw; do
	echo "pw-${s}-${RANDOM}" > "${W}/sec/${s}"
done
chmod 644 "${W}"/sec/*
printf '[s3]\ntype = local\n' > "${W}/rclone.conf"
# Every DB usage mounts this one file as its root password, since one server (or one password) serves them all
DBPW="$(cat "${W}/sec/dbpw")"

db() {
	local c="$1"
	shift
	docker exec "${c}" mariadb -uroot -p"${DBPW}" "$@"
}

# Args: container, table, expected value
db_has() {
	db "$1" -N -e "SELECT v FROM $2" | grep -q "$3"
}

# Args: container, port. TCP, because the temporary init server only listens on the socket
wait_db() {
	wait_for 120 db "$1" -h127.0.0.1 -P"$2" -e 'SELECT 1' || { echo "$1 did not start"; exit 1; }
}

# Args: container, database, value
seed() {
	db "$1" -e "CREATE DATABASE $2; CREATE TABLE $2.t (v VARCHAR(40)); INSERT INTO $2.t VALUES ('$3');" \
		|| { echo "Seeding $2 failed"; exit 1; }
}

# Args: container, network alias, extra server args
start_db() {
	local name="$1" alias="$2"
	shift 2
	docker run -d --label vb-verify --name "${name}" --network "${NET}" --network-alias "${alias}" \
		-e MARIADB_ROOT_PASSWORD="${DBPW}" "${DB_IMAGE}" "$@" >/dev/null
}

run_usage() {
	local name="$1"
	shift
	local c="vb-${name}" d="${W}/${name}"
	mkdir -p "${d}/data" "${d}/repo"
	echo "${name}-data" > "${d}/data/file.txt"
	mkdir -p "${d}/data/skip" "${d}/data/marked"
	echo skip > "${d}/data/skip/a.txt"
	echo marked > "${d}/data/marked/b.txt"
	touch "${d}/data/marked/.skip-marker"
	docker volume create --label vb-verify "vb-app-${name}" >/dev/null
	echo "== ${name}"
	docker run -d --label vb-verify --name "${c}" --network "${NET}" --init \
		--env-file "${CONFIG}/backup.env" \
		-e RCLONE_CONFIG=/rclone-test/rclone.conf \
		-e "EXCLUDE=pf:/data/skip" -e "EXCLUDE_IF_PRESENT=.skip-marker" \
		-v "${d}/data:/data" -v "${d}/repo:/repo" -v "vb-app-${name}:/app" \
		-v "${W}/rclone.conf:/rclone-test/rclone.conf:ro" -v "${W}/remote:/remote" \
		-v "${W}/sec/borg-repokey:/run/secrets/borg-repokey:ro" \
		-v "${W}/sec/s3-keyid:/run/secrets/s3-keyid:ro" \
		-v "${W}/sec/s3-passwd:/run/secrets/s3-passwd:ro" \
		"$@" "${IMAGE}" >/dev/null || { echo "  FAIL start"; fail=1; return; }
	# The entrypoint writes the cron file last, after /container.env
	check "${name}: cron job file" wait_for 30 docker exec "${c}" grep -q "root backup" /etc/cron.d/start
}

# Args: usage name, bucket directory, extra paths the archive must hold besides data/file.txt
inspect_backup() {
	local name="$1" bucket="$2"
	shift 2
	check "${name}: backup" docker exec "vb-${name}" backup
	check "${name}: archive contents" docker exec "vb-${name}" bash -c '
		source /container.env
		archive="$(borg list --glob-archives "${ARCHIVE_PREFIX}*" --last 1 --short "$BORG_REPO")"
		paths="$(borg list --format "{path}{NL}" "$BORG_REPO::$archive")"
		for p in "$@"; do
			grep -q "$p" <<<"$paths" || { echo "missing $p in $archive"; exit 1; }
		done' _ data/file.txt "$@"
	check "${name}: exclusions honored" docker exec "vb-${name}" bash -c '
		source /container.env
		archive="$(borg list --glob-archives "${ARCHIVE_PREFIX}*" --last 1 --short "$BORG_REPO")"
		paths="$(borg list --format "{path}{NL}" "$BORG_REPO::$archive")"
		if grep -qE "data/(skip|marked)/" <<<"$paths"; then
			echo "excluded paths in $archive:"
			grep -E "data/(skip|marked)/" <<<"$paths"
			exit 1
		fi'
	check "${name}: repo mirrored to remote" test -f "${W}/remote/${DOMAIN}/${bucket}/config"
	check "${name}: prune" docker exec "vb-${name}" prune
	check "${name}: check" docker exec "vb-${name}" check
}

# The backup leaves /other_data in the container; without removing it a restore could load that stale dump instead of the archive's
restore_usage() {
	docker exec "vb-$1" rm -rf /other_data
	check "$1: restore" bash -c "printf 'y\n' | docker exec -i vb-$1 restore"
}

docker network create "${NET}" >/dev/null
start_db vb-db database
start_db vb-dbport dbport --port=3307
# Stand-in for Nextcloud in maintenance mode (the hook accepts 404/503 without prompting)
docker run -d --label vb-verify --name vb-nc --network "${NET}" --network-alias nextcloud python:3-alpine python -c "
import http.server as h
class H(h.BaseHTTPRequestHandler):
    def do_HEAD(s): s.send_response(503); s.end_headers()
    do_GET = do_HEAD
h.HTTPServer(('',80),H).serve_forever()" >/dev/null

run_usage files \
	-e "ARCHIVE_PREFIX=files_${DOMAIN}_" -e "BUCKET_NAME=/remote/${DOMAIN}/files"
# The user gets another uid before the restore: without --numeric-ids Borg would restore by name
docker exec vb-files bash -c 'useradd -u 5000 ghost && echo ghost > /data/owned.txt && chown ghost:ghost /data/owned.txt'
inspect_backup files files

# Borg exits 1 on warnings. The wrapper makes borg create do so after it wrote the archive
warning_sync() {
	local out
	docker exec -i vb-files sh -c 'cat > /usr/local/bin/borg && chmod +x /usr/local/bin/borg' <<'WRAPPER'
#!/bin/sh
/usr/bin/borg "$@"
rc=$?
[ "$1" = create ] && [ "$rc" = 0 ] && exit 1
exit "$rc"
WRAPPER
	echo "files-more" > "${W}/files/data/more.txt"
	out="$(docker exec vb-files backup 2>&1)" || { echo "${out}"; return 1; }
	grep -q "finished with warnings" <<<"${out}" || { echo "${out}"; return 1; }
	docker exec vb-files diff -r /repo "/remote/${DOMAIN}/files"
}
check "files: warnings still sync" warning_sync
docker exec vb-files rm /usr/local/bin/borg

docker exec vb-files bash -c 'rm /data/file.txt /data/owned.txt && groupmod -g 6000 ghost && usermod -u 6000 ghost'
restore_usage files
check "files: file restored" grep -q files-data "${W}/files/data/file.txt"
check "files: numeric owner restored" test "$(docker exec vb-files stat -c %u:%g /data/owned.txt)" = 5000:5000

# A replaced repo must not overwrite the one in the bucket
replaced_repo_blocked() {
	docker exec vb-files bash -c 'rm -rf /repo/* /repo/.[!.]*'
	if docker exec vb-files backup; then
		echo "backup into an emptied repo succeeded"
		return 1
	fi
	test -f "${W}/remote/${DOMAIN}/files/config"
}
check "files: replaced repo does not overwrite the bucket" replaced_repo_blocked

wait_db vb-db 3306
seed vb-db appdb app-row
seed vb-db hookdb hook-row

run_usage mysql \
	-v "${W}/sec/dbpw:/run/secrets/dbpw:ro" \
	-e "ARCHIVE_PREFIX=mysql_${DOMAIN}_" -e "BUCKET_NAME=/remote/${DOMAIN}/mysql" \
	-e MYSQL_HOST=database -e MYSQL_DATABASE=appdb \
	-e MYSQL_ROOT_PASSWORD_FILE=/run/secrets/dbpw
inspect_backup mysql mysql other_data/mysql-dump.sql
rm "${W}/mysql/data/file.txt"
db vb-db -e "DROP DATABASE appdb"
restore_usage mysql
check "mysql: file restored" grep -q mysql-data "${W}/mysql/data/file.txt"
check "mysql: DB restored" db_has vb-db appdb.t app-row

run_usage hook \
	-v "${W}/sec/dbpw:/run/secrets/dbpw:ro" \
	-v "${CONFIG}/prepare:/app/prepare:ro" \
	-e "ARCHIVE_PREFIX=hook_${DOMAIN}_" -e "BUCKET_NAME=/remote/${DOMAIN}/hook" \
	-e MYSQL_HOST=database -e MYSQL_DATABASE=hookdb \
	-e MYSQL_ROOT_PASSWORD_FILE=/run/secrets/dbpw \
	-e NEXTCLOUD_HOST=nextcloud
inspect_backup hook hook other_data/mysql-dump.sql
rm "${W}/hook/data/file.txt"
db vb-db -e "DROP DATABASE hookdb"
wait_for 30 docker exec vb-hook curl -sI -o /dev/null http://nextcloud
restore_usage hook
check "hook: file restored" grep -q hook-data "${W}/hook/data/file.txt"
check "hook: DB restored" db_has vb-db hookdb.t hook-row

wait_db vb-dbport 3307
seed vb-dbport portdb port-row
run_usage port \
	-v "${W}/sec/dbpw:/run/secrets/dbpw:ro" \
	-e "ARCHIVE_PREFIX=port_${DOMAIN}_" -e "BUCKET_NAME=/remote/${DOMAIN}/port" \
	-e MYSQL_HOST=dbport -e MYSQL_PORT=3307 -e MYSQL_DATABASE=portdb \
	-e MYSQL_ROOT_PASSWORD_FILE=/run/secrets/dbpw \
	-e RESTORE_UID=7000 -e RESTORE_GID=7001
inspect_backup port port other_data/mysql-dump.sql
db vb-dbport -e "DROP DATABASE portdb"
rm "${W}/port/data/file.txt"
restore_usage port
check "port: DB restored" db_has vb-dbport portdb.t port-row
check "port: RESTORE_UID and RESTORE_GID applied" test "$(docker exec vb-port stat -c %u:%g /data/file.txt /data)" = $'7000:7001\n7000:7001'

# Args: container
sqlite_rows() {
	docker exec "$1" sqlite3 /data/app.db "SELECT count(*) FROM t"
}

# More than 100 pages, the step size of the sqlite3 CLI's .backup, so a writer can overlap a multi-step copy
seed_sqlite() {
	docker exec "$1" sh -c '
		sqlite3 /data/app.db "PRAGMA journal_mode=WAL; CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);
			WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i < 3000)
			INSERT INTO t (v) SELECT hex(randomblob(100)) FROM n;" &&
		chown 5000:5000 /data/app.db && chmod 640 /data/app.db' >/dev/null
}

# The live database is excluded, so a restored database can only come from the dump. Stale sidecar files
# must not survive: a leftover -wal would be applied to the restored database
delete_sqlite() {
	docker exec "$1" sh -c '
		rm -f /data/app.db /data/app.db-wal /data/app.db-shm /data/app.db-journal
		for s in -wal -shm -journal; do echo stale > "/data/app.db${s}"; done'
}

# Args: container, expected message, command...; the command must fail and print the message
fails_with() {
	local c="$1" msg="$2" out
	shift 2
	if out="$(docker exec "${c}" "$@" 2>&1)"; then
		echo "succeeded: ${out}"
		return 1
	fi
	grep -q "${msg}" <<<"${out}" || { echo "${out}"; return 1; }
}

# Args: SQLITE_FILES value; the container must refuse to start
rejects_start() {
	local out
	if out="$(docker run --rm -e BORG_PASSPHRASE=x -e BUCKET_NAME=x -e "SQLITE_FILES=$1" "${IMAGE}" true 2>&1)"; then
		echo "started with SQLITE_FILES=$1"
		return 1
	fi
	grep -q "SQLITE_FILES entries" <<<"${out}" || { echo "${out}"; return 1; }
}

SQLITE_EXCLUDE="pf:/data/skip pf:/data/app.db pf:/data/app.db-wal pf:/data/app.db-shm"

# A writer keeps inserting while the backup runs
run_usage sqlite \
	-e "ARCHIVE_PREFIX=sqlite_${DOMAIN}_" -e "BUCKET_NAME=/remote/${DOMAIN}/sqlite" \
	-e SQLITE_FILES=/data/app.db -e "EXCLUDE=${SQLITE_EXCLUDE}"
check "sqlite: database seeded" seed_sqlite vb-sqlite
docker exec -d vb-sqlite sh -c 'echo $$ > /tmp/writer.pid; while :; do
	sqlite3 /data/app.db ".timeout 5000" "INSERT INTO t (v) VALUES (hex(randomblob(100)))"; sleep 0.05; done'
rows_before="$(sqlite_rows vb-sqlite)"
inspect_backup sqlite sqlite other_data/sqlite/data/app.db
check "sqlite: writer was active during the backup" test "$(sqlite_rows vb-sqlite)" -gt "${rows_before}"
docker exec vb-sqlite sh -c 'kill "$(cat /tmp/writer.pid)"'
sleep 1
check "sqlite: live database not in archive" docker exec vb-sqlite bash -c '
	source /container.env
	archive="$(borg list --glob-archives "${ARCHIVE_PREFIX}*" --last 1 --short "$BORG_REPO")"
	if borg list --format "{path}{NL}" "$BORG_REPO::$archive" | grep -xE "data/app.db(-wal|-shm)?"; then exit 1; fi'

docker exec vb-sqlite mv /data/app.db /data/app.db.away
check "sqlite: missing database fails the backup" fails_with vb-sqlite "is not a file" backup
docker exec vb-sqlite mv /data/app.db.away /data/app.db

delete_sqlite vb-sqlite
restore_usage sqlite
check "sqlite: stale sidecar files removed" docker exec vb-sqlite bash -c 'test ! -e /data/app.db-wal -a ! -e /data/app.db-shm -a ! -e /data/app.db-journal'
check "sqlite: owner and mode restored" test "$(docker exec vb-sqlite stat -c %u:%g:%a /data/app.db)" = 5000:5000:640
check "sqlite: integrity ok" test "$(docker exec vb-sqlite sqlite3 /data/app.db 'PRAGMA integrity_check')" = ok
check "sqlite: rows committed before the backup restored" test "$(sqlite_rows vb-sqlite)" -ge "${rows_before}"

# SQLITE_FILES is fixed at start, so the container.env of the running container is pointed at another path
missing_parent() {
	docker exec vb-sqlite bash -c '
		cp /container.env /tmp/container.env.orig
		sed -i "/SQLITE_FILES=/s#/data/app.db#/data/gone/app.db#" /container.env
		mkdir -p /other_data/sqlite/data/gone && cp /other_data/sqlite/data/app.db /other_data/sqlite/data/gone/
		out="$(backup-sqlite restore 2>&1)"; rc=$?
		cp /tmp/container.env.orig /container.env
		echo "${out}"
		[ "${rc}" -ne 0 ] && grep -q "does not exist" <<<"${out}"'
}
check "sqlite: restore without parent directory fails" missing_parent
docker exec vb-sqlite rm -f /other_data/sqlite/data/app.db
check "sqlite: restore without dump fails" fails_with vb-sqlite "not found" backup-sqlite restore

check "sqlite: relative path rejected at start" rejects_start "app.db"
check "sqlite: single quote rejected at start" rejects_start "/data/it's.db"

# Same flow with RESTORE_UID and RESTORE_GID, which backup-borg applies to the dump before it is copied back
run_usage sqliteuid \
	-e "ARCHIVE_PREFIX=sqliteuid_${DOMAIN}_" -e "BUCKET_NAME=/remote/${DOMAIN}/sqliteuid" \
	-e SQLITE_FILES=/data/app.db -e "EXCLUDE=${SQLITE_EXCLUDE}" \
	-e RESTORE_UID=7000 -e RESTORE_GID=7001
check "sqliteuid: database seeded" seed_sqlite vb-sqliteuid
check "sqliteuid: backup" docker exec vb-sqliteuid backup
delete_sqlite vb-sqliteuid
restore_usage sqliteuid
check "sqliteuid: RESTORE_UID and RESTORE_GID applied" test "$(docker exec vb-sqliteuid stat -c %u:%g:%a /data/app.db)" = 7000:7001:640

# SQLite needs to create -shm next to the database, so a read-only mount cannot be backed up
mkdir -p "${W}/sqlite-ro"
docker run --rm --entrypoint sqlite3 -v "${W}/sqlite-ro:/ro" "${IMAGE}" /ro/app.db "CREATE TABLE t (v)" >/dev/null
run_usage sqlitero \
	-v "${W}/sqlite-ro:/ro:ro" \
	-e "ARCHIVE_PREFIX=sqlitero_${DOMAIN}_" -e "BUCKET_NAME=/remote/${DOMAIN}/sqlitero" \
	-e SQLITE_FILES=/ro/app.db
check "sqlitero: read-only directory fails the backup" fails_with vb-sqlitero "read-write" backup

echo
if ((fail)); then
	echo "RESULT: FAILURES"
else
	echo "RESULT: all passed"
fi
exit "${fail}"
